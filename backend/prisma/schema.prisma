// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  caption   String?        @db.Text
  status    CampaignStatus @default(DRAFT)
  budget    Decimal        @db.Decimal(12, 2)
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@map("campaigns")
}

enum MessageRole {
  USER
  ASSISTANT
}

enum PendingActionType {
  CREATE
  UPDATE
  DELETE
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  CANCELED
  EXPIRED
}

enum NotificationType {
  AI_TASK
  SYSTEM
}

model PendingAiAction {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId   String
  conversation     Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type             PendingActionType
  targetCampaignId String?
  payload          Json
  status           PendingActionStatus @default(PENDING)
  createdAt        DateTime            @default(now())
  resolvedAt       DateTime?

  messages      Message[]
  notifications Notification[]

  @@index([userId, status])
  @@map("pending_ai_actions")
}

model Notification {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            NotificationType @default(SYSTEM)
  text            String
  link            String?
  pendingActionId String?
  pendingAction   PendingAiAction? @relation(fields: [pendingActionId], references: [id], onDelete: SetNull)
  read            Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  name             String?
  businessName     String?
  location         String?
  category         String?
  categoryOther    String?
  adExperience     String?
  budget           String?
  goal             String?
  signatureProduct String?        @db.Text
  platforms        String[]       @default([])
  peakHours        String?
  promoHighlight   String?        @db.Text
  customerPersona  String?        @db.Text
  conversations    Conversation[]
  aiMemory         AiMemory[]
  campaigns        Campaign[]
  pendingAiActions PendingAiAction[]
  notifications    Notification[]
  aiMemoryConsentAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("users")
}

model AiMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String   @db.Text
  answer    String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("ai_memory")
}

model Conversation {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         Message[]
  pendingAiActions PendingAiAction[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@map("conversations")
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String           @db.Text
  list            String[]         @default([])
  closing         String?
  redacted        Boolean          @default(false)
  pendingActionId String?
  pendingAction   PendingAiAction? @relation(fields: [pendingActionId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}
