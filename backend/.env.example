# Plain postgres:// only - @prisma/adapter-pg cannot use prisma+postgres://
DATABASE_URL="postgres://user:password@localhost:5432/clickdee"

PORT=3000
NODE_ENV=development

# AI: a six-tier cascade across Gemini and Groq (both OpenAI-SDK-compatible
# endpoints; see src/lib/openai.ts for the pinned model chain). Only the keys
# are required — base URLs default sensibly if omitted (see src/config/env.ts).
# Configuring only one provider's key is fine; the other's tiers are skipped.
GEMINI_API_KEY=changeme
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_API_KEY=changeme
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Research pipeline (Distiller -> cache -> Compound -> Formatter) that backs
# AI-proposed campaign captions — see src/lib/compound.ts. Requires
# GROQ_API_KEY above; if unset, research is silently skipped and captions
# fall back to the plain chat-generated draft. Groq decommissioned
# groq/compound on 2026-09-21, so this must be a model that supports Groq's
# built-in browser_search tool (openai/gpt-oss-20b or -120b; 20b is faster,
# ~15s per search). Results are cached to keep web-search calls down.
GROQ_COMPOUND_MODEL=openai/gpt-oss-20b
COMPOUND_CACHE_DEFAULT_TTL_SECONDS=21600
COMPOUND_CACHE_WEATHER_TTL_SECONDS=3600

AUTH_JWT_SECRET=changeme
AI_MEMORY_ENCRYPTION_KEY=changeme

# Number of AI-generated follow-up questions asked during onboarding before it stops. Optional, defaults to 5.
MAX_FOLLOWUP_QUESTIONS=5

# Global daily cap on the public onboarding follow-up endpoint (all clients
# combined), on top of its per-IP limit. Bounds AI spend. Optional, defaults to 500.
FOLLOWUP_DAILY_CAP=500

# Comma-separated browser origins allowed by CORS on /api/*. Optional,
# defaults to the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Only set to true behind a reverse proxy you control that overwrites
# X-Real-IP (the Docker image sets this for its bundled nginx). Leave false
# when the backend is reachable directly, or clients could spoof their IP.
TRUST_PROXY=false

# Live-AI-call test budget guard (src/lib/ai-live-test-guard.ts) — caps how
# many real provider calls an opt-in `test:live` run may make per process.
MAX_LIVE_CALLS_PER_RUN=5
MAX_LIVE_COMPOUND_CALLS_PER_RUN=2

# Meta Marketing API. All optional — dev-only stand-in credentials for a
# single test Business Manager / ad account, used until a real per-user OAuth
# connection flow exists (see backend/docs/meta-marketing-api-findings.md).
# POST /api/campaigns/:id/publish-to-meta returns a clear "not configured"
# error rather than crashing when these are unset.
META_API_VERSION=v21.0
META_DEV_ACCESS_TOKEN=changeme
META_DEV_AD_ACCOUNT_ID=changeme
META_DEV_PAGE_ID=changeme
META_DEV_INSTAGRAM_USER_ID=changeme

# Demo/offline escape hatch — when true, skips the actual Meta HTTP call for
# every campaign/ad-set/creative/ad/media publish action and synthesizes a
# successful result instead (still runs all local validation). Off by
# default; only turn on temporarily (e.g. a live demo) when real Meta calls
# aren't viable. See backend/CLAUDE.md's "Meta campaign hierarchy" section.
META_SIMULATE_PUBLISH=false

# Cloudinary — optional, best-effort preview-image/video hosting alongside
# Meta's own upload (see backend/CLAUDE.md's "Cloudinary media hosting"
# section). Your Cloudinary dashboard shows these three combined as a single
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>; split it
# into the three vars below. When unset, uploads still work end to end
# (Meta-only) but no preview URL is available until the ad is published.
CLOUDINARY_CLOUD_NAME=changeme
CLOUDINARY_API_KEY=changeme
CLOUDINARY_API_SECRET=changeme
