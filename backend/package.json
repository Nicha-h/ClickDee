    "@prisma/client": "^7.10.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "openai": "^7.53.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
